# AirDrop receiver -- the user half of the service pair.
#
# Runs bin/airdrop-serve.py as the user: port 8771, the user's keys, the user's
# download folder from ~/.config/airdrop/config.toml. Never root -- that is what
# makes received files the user's without a chown. The radio control plane
# (driver, interface, gate, announcer, peer registration) belongs to the
# system side; this unit only requires the selected interface and its link-local.
#
# @PLUGIN_DIR@ is substituted with the plugin's own directory when `ucandrop
# setup` installs this file into ~/.config/systemd/user/. Do not install this
# template by hand: a unit still carrying the placeholder cannot start, and
# setup refuses to write one.
#
# NOT enabled. `ucandrop on` starts it for the length of a receive window and
# `ucandrop off` stops it again, which is what keeps "visible to everyone" a
# bounded state. Enabling it would make this machine receive all the time.
# Config change = restart: systemctl --user restart ucandrop-receiver.service

[Unit]
Description=AirDrop receiver over the configured radio backend
# The selected interface is created by the radio control plane; wait for it.
# No device-unit dependency is used: the interface may appear
# long after the user manager starts, and on some machines that manager never
# activates the device unit, so the start waited on it until it timed out and
# failed with result 'dependency' (issue 12). The link-local wait below does
# the job that dependency was for. An assert, not a condition: a condition
# that fails skips the unit and reports success, and `ucandrop on` would then
# announce a receiver that is not running.
AssertPathExists=@IFACE_SYSFS@

[Service]
Type=simple
WorkingDirectory=@PLUGIN_DIR@
# Keep the user receiver's identity/settings and the CLI on the same XDG root
# even when setup was run with a custom XDG_CONFIG_HOME. `%t` is systemd's
# canonical per-user runtime directory, matching the radio identity contract.
Environment=XDG_CONFIG_HOME=@CONFIG_HOME@
Environment=XDG_RUNTIME_DIR=%t
# name / model / download_dir come from @CONFIG_PATH@; setup renders that
# explicit path because a user manager need not inherit the shell's
# XDG_CONFIG_HOME. The receiver validates the file and refuses to start on a
# bad value (exit 1, and systemd's default start limit stops the retry storm).
# A restart can outrun its own predecessor's socket teardown: one did, the
# receiver cannot silently move to an unadvertised port. Wait for the port to
# clear rather than racing for it.
ExecStartPre=/bin/sh -c 'for i in $(seq 1 40); do ss -Hltn 2>/dev/null | grep -q ":8771 " || exit 0; sleep 0.25; done; echo "port 8771 still busy after 10s" >&2; exit 1'
# The interface exists a moment before it carries its link-local, and the receiver
# refuses to start without one. Wait for the address.
ExecStartPre=/bin/sh -c 'for i in $(seq 1 60); do ip -6 addr show dev @IFACE@ scope link 2>/dev/null | grep -q inet6 && exit 0; sleep 0.5; done; echo "configured radio interface has no link-local after 30s" >&2; exit 1'
ExecStart=/usr/bin/python3 @PLUGIN_DIR@/bin/airdrop-serve.py --iface @IFACE@ --port 8771 --config @CONFIG_PATH@
Restart=on-failure
RestartSec=2s
# Hardening: it serves HTTPS on one port and writes into one directory.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
# The download folder and the identity dir (~/.omdrop) are the only writable paths;
# ReadWritePaths is re-evaluated at start, so a config change to download_dir
# needs the matching path added here (deliberate: the unit declares what it may
# write). `ucandrop dir` writes a drop-in that does exactly that.
ReadWritePaths=@DOWNLOAD_DIR@ %h/.omdrop
# Opt-in protocol dumps (OMDROP_DEBUG=1) go to the runtime directory, never the
# home directory: they can carry validation records. `-`: absent unless used.
ReadWritePaths=-%t/ucandrop/debug
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET6 AF_INET AF_UNIX AF_NETLINK
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# The identity's private key is in this process's memory for the window.
LimitCORE=0

[Install]
WantedBy=default.target
