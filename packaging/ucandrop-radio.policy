<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/software/polkit/policyconfig-1.dtd">

<!-- The only privileged entry point is the root-owned, package-installed
     radio helper.  No arbitrary command or user-controlled path is granted. -->
<policyconfig>
  <vendor>UCanDrop</vendor>
  <action id="net.ucandrop.radio.discover">
    <description>Make this computer visible to nearby Apple devices</description>
    <message>Authentication is required to change radio discoverability</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/ucandrop/radio/omdrop-discoverable</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
